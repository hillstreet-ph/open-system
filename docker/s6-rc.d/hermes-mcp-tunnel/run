#!/command/with-contenv sh
# shellcheck shell=sh

set -eu

# Dashboard-managed custom keys live in the durable Hermes .env file rather
# than Docker's process environment. Import only the two tunnel settings; do
# not source the whole file because unrelated values may not be shell syntax.
env_value() {
    sed -n "s/^$1=//p" /opt/data/.env 2>/dev/null | head -n 1 | tr -d '\r'
}

if [ -z "${CONTROL_PLANE_API_KEY:-}" ]; then
    CONTROL_PLANE_API_KEY="$(env_value CONTROL_PLANE_API_KEY)"
    export CONTROL_PLANE_API_KEY
fi
if [ -z "${CONTROL_PLANE_TUNNEL_ID:-}" ]; then
    CONTROL_PLANE_TUNNEL_ID="$(env_value CONTROL_PLANE_TUNNEL_ID)"
    export CONTROL_PLANE_TUNNEL_ID
fi

# The tunnel is opt-in. Both values are deployment secrets/settings; when
# either is absent this service remains dormant and the normal Hermes image
# behaves exactly as before.
if [ -z "${CONTROL_PLANE_API_KEY:-}" ] || [ -z "${CONTROL_PLANE_TUNNEL_ID:-}" ]; then
    exec sleep infinity
fi

export MCP_COMMAND="${MCP_COMMAND:-hermes mcp serve}"
export HEALTH_LISTEN_ADDR="${HEALTH_LISTEN_ADDR:-127.0.0.1:18080}"
export LOG_FORMAT="${LOG_FORMAT:-json}"
export LOG_LEVEL="${LOG_LEVEL:-info}"

exec s6-setuidgid hermes /usr/local/bin/tunnel-client run
