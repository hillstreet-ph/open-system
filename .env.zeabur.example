# Hermes Agent cloud (.env) for Zeabur deployment.
# Copy to .env and fill in values. Secrets only here — behaviour goes in config.yaml.
#
# Required:
API_SERVER_KEY=<generate a strong random token, e.g. `openssl rand -hex 32`>
#
# Optional:
# HERMES_UID=10000
# HERMES_GID=10000
#
# Platform adapter credentials (Telegram, Discord, Slack, …) — set only the
# adapters you use on the cloud server:
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_APP_TOKEN=
