# Open-System integration environment contract
# Values are supplied only through Zeabur/provider secret stores.
# Never commit populated copies of this file.

OPEN_CONNECT_MCP_URL=https://open-connect.site/mcp
OPEN_CONNECT_MODEL_BASE_URL=https://open-connect.site/v1
OPEN_CONNECT_API_KEY=

OPEN_SYSTEM_PUBLIC_URL=https://open-system.space
OPEN_SYSTEM_API_ORIGIN=https://api.open-system.space
OPEN_SYSTEM_ENVIRONMENT=production

# Supabase public identifiers. Server credentials remain secret.
OPEN_PLATFORM_SUPABASE_URL=https://huadtiuuoiriqrjpjxhr.supabase.co
OPEN_PLATFORM_SUPABASE_PUBLISHABLE_KEY=
OPEN_PLATFORM_SUPABASE_SERVICE_ROLE_KEY=
OPEN_OPERATIONS_SUPABASE_URL=https://hoseohvgoiarxluxqwqv.supabase.co
OPEN_OPERATIONS_SUPABASE_PUBLISHABLE_KEY=
OPEN_OPERATIONS_SUPABASE_SERVICE_ROLE_KEY=

# Open-TGate owns multi-bot routing. Do not configure two bot tokens in the
# native Hermes Telegram gateway.
OPEN_TGATE_API_URL=
OPEN_TGATE_SERVICE_TOKEN=
OPEN_TGATE_HILLSTREET_BOT_TOKEN=
OPEN_TGATE_KOBEPLAY_BOT_TOKEN=

# Workspace routing identifiers are discovered after verified Telegram sync.
HILLSTREET_TELEGRAM_CHAT_ID=
KOBEPLAY_TELEGRAM_CHAT_ID=
HILLSTREET_COMMAND_TOPIC_ID=
KOBEPLAY_COMMAND_TOPIC_ID=

# Provider connections are referenced, not copied into agent prompts.
NOTION_CONNECTION_ID=
AIRTABLE_CONNECTION_ID=
GITHUB_CONNECTION_ID=
GOOGLE_DRIVE_CONNECTION_ID=

# Audit and approval behavior.
OPEN_SYSTEM_REQUIRE_PRODUCTION_APPROVAL=true
OPEN_SYSTEM_REQUIRE_CREDENTIAL_APPROVAL=true
OPEN_SYSTEM_REQUIRE_FINANCE_APPROVAL=true
OPEN_SYSTEM_REQUIRE_DESTRUCTIVE_APPROVAL=true
OPEN_SYSTEM_AUDIT_REDACT_SECRETS=true
